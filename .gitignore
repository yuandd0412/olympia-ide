# Build output
build/
out/
cmake-build-*/

# Qt
.qt/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/

# Vendored third-party (re-cloneable)
third_party/

# Vendored VS Code fork that the Olympia product is compiled from (checkout, not authored here)
/oss/

# Unpacked product tree emitted by build/oss-package.ps1; the scripts under build/ are tracked
# deliberately even though this directory stays ignored for the Qt-era artifacts.
/VSCode-win32-x64/

# Downloaded toolchain used by the "full" installer build (frontend/src-tauri)
frontend/src-tauri/vendor/

# Installer artifacts staged for Pages deployment (copied in before deploy, see website/DEPLOY.md)
website/downloads/
website/.wrangler/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~
*.user
*.user.*

# OS
Thumbs.db
.DS_Store
desktop.ini

# Logs / temp
*.log
*.tmp
*.bak

# Local env / secrets
.env
.env.local
*.local

# Local curl cookie jar from OJ scrape testing (may hold session credentials)
/cookies.txt

# Local scratch, agent working dirs and release artifacts (never published)
# These hold chat transcripts, provider credentials and 300MB+ installers.
# A plain `git add -A` used to stage 6600+ of them.
/.scratch/
/.zcode/
/.zcodeignore
/.superdesign/
/.superpowers/
/dist/
backup-*.patch
/linux-port-prompt.md

# Internal agent handoff notes (process artifacts for the retired Tauri line,
# not product documentation)
/docs/zcode-*.md
