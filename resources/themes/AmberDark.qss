/* AmberDark - dark, warm amber/terracotta accent */
QMainWindow, QWidget { background-color: #131311; color: #f1f1ef; }
QMenuBar { background-color: rgba(0,0,0,0.35); color: #f1f1ef; border-bottom: 1px solid #252524; }
QMenuBar::item:selected { background-color: #252524; }
QMenu { background-color: #2c2c2b; color: #f1f1ef; border: 1px solid #353533; border-radius: 6px; }
QMenu::item { padding: 4px 24px 4px 12px; }
QMenu::item:selected { background-color: rgba(217,119,87,0.15); color: #e08a6c; }

/* Inputs */
QLineEdit, QPlainTextEdit, QTextBrowser, QSpinBox, QComboBox {
  background-color: #1a1915;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 6px;
  padding: 3px 8px;
  color: #f1f1ef;
  selection-background-color: rgba(217,119,87,0.35);
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextBrowser:focus {
  border: 1px solid rgba(217,119,87,0.40);
}
QLineEdit:disabled, QComboBox:disabled { color: #46443b; }
QTextBrowser { padding: 8px; }
QTextEdit { background-color: #1a1915; color: #f1f1ef; border: none; selection-background-color: rgba(217,119,87,0.35); }

QPushButton {
  background-color: #252524; color: #f1f1ef;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 6px; padding: 5px 14px;
}
QPushButton:hover { background-color: rgba(217,119,87,0.08); border-color: rgba(217,119,87,0.40); color: #e08a6c; }
QPushButton:pressed { background-color: rgba(217,119,87,0.15); }
QPushButton:default { border-color: rgba(217,119,87,0.40); }

QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
  background-color: #2c2c2b; color: #f1f1ef;
  border: 1px solid #353533; border-radius: 6px;
  selection-background-color: rgba(217,119,87,0.15); outline: none;
}

/* Tables */
QHeaderView::section {
  background-color: #1a1915; color: #6e6d68;
  border: none; border-right: 1px solid rgba(255,255,255,0.06);
  border-bottom: 1px solid rgba(255,255,255,0.06);
  padding: 4px 8px;
}
QTableWidget {
  background-color: #131311; alternate-background-color: #161512;
  gridline-color: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.06); border-radius: 8px;
}
QTableWidget::item { padding: 4px 6px; border: none; }
QTableWidget::item:hover { background-color: #252524; }
QTableWidget::item:selected { background-color: rgba(217,119,87,0.15); color: #f1f1ef; }
QTableView::corner { background-color: #1a1915; border: none; }

/* Rail + tab strip */
#activityRail { background-color: #131311; border-right: 1px solid rgba(255,255,255,0.06); }
#activityRail QToolButton {
  background: transparent; color: #a0a0a3;
  border: none; border-left: 3px solid transparent;
  border-radius: 6px; padding: 10px 2px;
  font-size: 12px; font-weight: 500;
}
#activityRail QToolButton:hover { background-color: #1a1915; color: #f1f1ef; }
#activityRail QToolButton:checked {
  background-color: rgba(217,119,87,0.15);
  border-left: 3px solid #d97757; color: #d97757;
}

#editorTitle { color: #6e6d68; padding-left: 12px; background: transparent; }
#recentStrip { color: #6e6d68; }
#settingsGroupHeader { font-size: 16px; font-weight: 600; color: #f1f1ef; padding-bottom: 2px; }
#shortcutRef { color: #6e6d68; }
#goalBar { border-radius: 2px; min-width: 240px; max-width: 360px; }

/* Problem cards + KPI cards (spec section 4.1/4.2) */
#problemCard {
  background-color: #1a1915;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 8px;
}
#problemCard:hover { background-color: #252524; border-color: rgba(217,119,87,0.40); }
#cardId { color: #d97757; font-family: Consolas, monospace; font-weight: 500; }
#cardTitle { color: #f1f1ef; }
#chipBadge { background-color: rgba(255,255,255,0.04); border-radius: 2px; padding: 1px 6px; }
#recentChip {
  background-color: #1a1915; color: #a0a0a3;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 6px; padding: 4px 10px;
}
#recentChip:hover { border-color: rgba(217,119,87,0.40); color: #e08a6c; }
#sectionCaption { color: #6e6d68; font-size: 11px; letter-spacing: 1px; }
#recentEmpty { color: #6e6d68; }
#kpiCard {
  background-color: #1a1915;
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 8px;
}
QListWidget {
  background-color: #131311; color: #a0a0a3;
  border: 1px solid rgba(255,255,255,0.06); border-radius: 8px;
  outline: none;
}
QListWidget::item { padding: 8px 10px; border-radius: 6px; }
QListWidget::item:selected { background-color: rgba(217,119,87,0.15); color: #f1f1ef; }
QListWidget::item:hover:!selected { background-color: #1a1915; }

QTabBar::tab { background-color: #131311; color: #a0a0a3; padding: 7px 14px; border-right: 1px solid rgba(255,255,255,0.06); }
QTabBar::tab:selected { background-color: #1a1915; color: #f1f1ef; border-bottom: 2px solid #d97757; }

/* Scrollbars 鈥?thin, dark */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #2c2c2b; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #353533; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #2c2c2b; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #353533; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* Splitter */
QSplitter::handle { background-color: #131311; }
QSplitter::handle:horizontal { height: 4px; }
QSplitter::handle:vertical { width: 4px; }
QSplitter::handle:hover { background-color: rgba(217,119,87,0.40); }

QStatusBar { background-color: rgba(0,0,0,0.35); color: #6e6d68; border-top: 1px solid #252524; }
QToolTip { background-color: #2c2c2b; color: #f1f1ef; border: 1px solid #353533; padding: 4px; }

/* Custom titlebar (spec 3.1) */
#titlebar { background-color: rgba(0,0,0,0.35); border-bottom: 1px solid rgba(255,255,255,0.06); }
#titlebarTitle { font-size: 12px; font-weight: 600; color: #a0a0a3; letter-spacing: 0.3px; }
#titlebarClock { font-family: Consolas, monospace; font-size: 11px; color: #6e6d68; letter-spacing: 0.5px; }
QToolButton#tbBtn { background: transparent; border: none; border-radius: 6px; }
QToolButton#tbBtn:hover { background-color: rgba(255,255,255,0.08); }
QToolButton#tbClose { background: transparent; border: none; border-radius: 6px; }
QToolButton#tbClose:hover { background-color: rgba(255,69,58,0.85); }


/* ---- v1.1: single-column settings + feedback states ---- */
#settingsH1 { font-size: 20px; font-weight: 600; }
#settingsSub { font-size: 12px; color: %TERTIARY%; }
#sectionTitleLabel { font-size: 14px; font-weight: 500; }
#fLabel { font-size: 12px; color: %SECONDARY%; }
#fHint, #fSuffix { font-size: 11px; color: %TERTIARY%; }
#divider { border: none; border-top: 1px solid %BORDER%; }
QPushButton[pill="true"] {
  height: 28px; padding: 0 14px; border-radius: 9999px;
  background: transparent; border: 1px solid %BORDER%;
  color: %SECONDARY%; font-size: 12px;
}
QPushButton[pill="true"]:hover { border-color: %BORDER_HOVER%; color: #f1f1ef; }
QPushButton[pill="true"]:checked { background-color: #d97757; border-color: #d97757; color: #ffffff; }
QPushButton[pill="true"]:pressed { background: %PRIMARY_MUTED%; }
#kbdKey {
  background: %ELEVATED%; border: 1px solid %BORDER_HOVER%;
  border-radius: 2px; padding: 1px 6px;
  font-family: 'Consolas'; font-size: 11px; color: #f1f1ef;
}
QMenu { border-radius: 8px; padding: 6px; }
QMenu::item { padding: 7px 24px 7px 16px; border-radius: 6px; margin: 0 4px; }


/* ---- v1.2: problems page pixel-port ---- */
#searchWrap { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; }
#searchWrap:focus-within { border-color: %BORDER_ACTIVE%; }
#searchInput { background: transparent; border: none; font-size: 13px; color: #f1f1ef; }
#searchInput::placeholder { color: #46443b; }
QPushButton[psPrimary="true"] { background: %PRIMARY%; color: #ffffff; border: none; border-radius: 6px; min-height: 32px; padding: 0 14px; font-size: 12px; font-weight: 500; }
QPushButton[psPrimary="true"]:hover { background: %PRIMARY_HOVER%; }
QPushButton[psPrimary="true"]:pressed { background: %PRIMARY%; }
QPushButton[psPrimary="true"]:disabled { color: rgba(255,255,255,0.5); }
QPushButton[psSecondary="true"] { background: %ELEVATED%; color: %SECONDARY%; border: 1px solid %BORDER%; border-radius: 6px; min-height: 32px; padding: 0 14px; font-size: 12px; font-weight: 500; }
QPushButton[psSecondary="true"]:hover { background: %OVERLAY%; border-color: %BORDER_HOVER%; color: #f1f1ef; }
QPushButton[psSecondary="true"]:pressed { background: %BORDER%; }
QPushButton[psSecondary="true"]:disabled { color: #46443b; }
#sectionTitle { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; }
#sectionAction { font-size: 11px; color: %TERTIARY%; }
#favCard { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#favCard:hover { background: %ELEVATED%; border-color: %BORDER_HOVER%; }
#favId { font-family: 'Consolas'; font-size: 11px; font-weight: 500; color: %ACCENT%; }
#favTitle { font-size: 12px; color: %SECONDARY%; }
#problemCard { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#problemCard:hover { background: %ELEVATED%; border-color: %BORDER_HOVER%; }
#problemCard:pressed { background: %OVERLAY%; }
#cardId { font-family: 'Consolas'; font-size: 12px; font-weight: 500; letter-spacing: 0.3px; color: %ACCENT%; }
#cardTitle { font-size: 13px; font-weight: 500; line-height: 1.35; color: #f1f1ef; }
#ojPill { border-radius: 9999px; padding: 2px 7px; font-size: 10px; font-weight: 600; }
#diffLabel { font-size: 10px; color: %TERTIARY%; }
#statsStrip { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#statValue { font-family: 'Consolas'; font-size: 15px; font-weight: 600; letter-spacing: -0.3px; color: #f1f1ef; }
#statStripLabel { font-size: 11px; color: %TERTIARY%; }
#statsDiv { background: %BORDER%; border: none; max-width: 1px; }

/* ---- v1.2: mistakes cards ---- */
QWidget[mistakeCard="true"] { background: %SURFACE%; border: 1px solid %BORDER%; border-left: 3px solid #ff453a; border-radius: 8px; }
QWidget[mistakeCard="true"]:hover { background: %ELEVATED%; }
#redoBtn { background: %PRIMARY_MUTED%; color: %PRIMARY%; border: 1px solid %BORDER_ACTIVE%; border-radius: 6px; padding: 4px 10px; font-size: 11px; }
#redoBtn:hover { background: %PRIMARY_SUBTLE%; }
QPushButton[mchipBtn="true"] { height: 26px; padding: 0 10px; border-radius: 6px; font-family: 'Consolas'; font-size: 11px; font-weight: 600; background: transparent; border: 1px solid transparent; color: %TERTIARY%; }
QPushButton[mchipBtn="true"]:checked { background: %OVERLAY%; color: #f1f1ef; border-color: %BORDER_HOVER%; }

/* ---- v1.2: ai chat ---- */
#aiBubbleUser { background: #2c2520; border: 1px solid rgba(217,119,87,0.12); border-radius: 8px; border-top-right-radius: 6px; padding: 10px 14px; }
#aiBubbleAi { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; border-top-left-radius: 6px; padding: 10px 14px; }
#aiAvatar { border-radius: 14px; font-size: 11px; font-weight: 600; }
#aiComposer { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; color: #f1f1ef; font-size: 13px; }
#aiSend { background: %PRIMARY%; border-radius: 18px; border: none; }
#aiSend:hover { background: %PRIMARY_HOVER%; }

/* ---- v1.2: editor file tabs ---- */
#edTabBar { background: %BASE%; border-bottom: 1px solid %BORDER%; }
#edTab { padding: 0 14px; font-size: 12px; color: %TERTIARY%; border-right: 1px solid %BORDER%; }
#edTabActive { background: %SURFACE%; color: #f1f1ef; border-top: 2px solid %PRIMARY%; }
