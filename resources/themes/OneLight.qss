/* OneLight - light, blue-purple accent */
QMainWindow, QWidget { background-color: #fafafa; color: #383a42; }
QMenuBar { background-color: #f0f0f0; color: #383a42; border-bottom: 1px solid #e0e0e0; }
QMenuBar::item:selected { background-color: #e8e8e8; }
QMenu { background-color: #ffffff; color: #383a42; border: 1px solid #d0d0d0; border-radius: 6px; }
QMenu::item { padding: 4px 24px 4px 12px; }
QMenu::item:selected { background-color: rgba(64,120,242,0.12); color: #4078f2; }

/* Inputs */
QLineEdit, QPlainTextEdit, QTextBrowser, QSpinBox, QComboBox {
  background-color: #ffffff;
  border: 1px solid #d0d0d0;
  border-radius: 6px;
  padding: 3px 8px;
  color: #383a42;
  selection-background-color: rgba(64,120,242,0.25);
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextBrowser:focus {
  border: 1px solid rgba(64,120,242,0.60);
}
QLineEdit:disabled, QComboBox:disabled { color: #a0a1a7; }
QTextBrowser { padding: 8px; }
QTextEdit { background-color: #ffffff; color: #383a42; border: none; selection-background-color: rgba(64,120,242,0.25); }

QPushButton {
  background-color: #f0f0f0; color: #383a42;
  border: 1px solid #d0d0d0;
  border-radius: 6px; padding: 5px 14px;
}
QPushButton:hover { background-color: rgba(64,120,242,0.10); border-color: rgba(64,120,242,0.50); color: #4078f2; }
QPushButton:pressed { background-color: rgba(64,120,242,0.18); }

QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
  background-color: #ffffff; color: #383a42;
  border: 1px solid #d0d0d0; border-radius: 6px;
  selection-background-color: rgba(64,120,242,0.12); outline: none;
}

/* Tables */
QHeaderView::section {
  background-color: #f0f0f0; color: #a0a1a7;
  border: none; border-right: 1px solid #e0e0e0;
  border-bottom: 1px solid #e0e0e0;
  padding: 4px 8px;
}
QTableWidget {
  background-color: #ffffff; alternate-background-color: #f7f7f7;
  gridline-color: #ececec;
  border: 1px solid #d0d0d0; border-radius: 8px;
}
QTableWidget::item { padding: 4px 6px; border: none; }
QTableWidget::item:hover { background-color: #f0f0f0; }
QTableWidget::item:selected { background-color: rgba(64,120,242,0.15); color: #383a42; }
QTableView::corner { background-color: #f0f0f0; border: none; }

/* Rail + tab strip */
#activityRail { background-color: #f0f0f0; border-right: 1px solid #e0e0e0; }
#activityRail QToolButton {
  background: transparent; color: #a0a1a7;
  border: none; border-left: 3px solid transparent;
  border-radius: 6px; padding: 10px 2px;
  font-size: 12px; font-weight: 500;
}
#activityRail QToolButton:hover { background-color: #e8e8e8; color: #383a42; }
#activityRail QToolButton:checked {
  background-color: rgba(64,120,242,0.15);
  border-left: 3px solid #4078f2; color: #4078f2;
}

#editorTitle { color: #a0a1a7; padding-left: 12px; background: transparent; }
#recentStrip { color: #a0a1a7; }
#settingsGroupHeader { font-size: 16px; font-weight: 600; color: #383a42; padding-bottom: 2px; }
#shortcutRef { color: #a0a1a7; }
#goalBar { border-radius: 2px; min-width: 240px; max-width: 360px; }

/* Problem cards + KPI cards */
#problemCard {
  background-color: #ffffff;
  border: 1px solid #d0d0d0;
  border-radius: 8px;
}
#problemCard:hover { background-color: #f5f6fa; border-color: rgba(64,120,242,0.50); }
#cardId { color: #4078f2; font-family: Consolas, monospace; font-weight: 500; }
#cardTitle { color: #383a42; }
#chipBadge { background-color: rgba(0,0,0,0.04); border-radius: 2px; padding: 1px 6px; }
#recentChip {
  background-color: #ffffff; color: #a0a1a7;
  border: 1px solid #e0e0e0;
  border-radius: 6px; padding: 4px 10px;
}
#recentChip:hover { border-color: rgba(64,120,242,0.50); color: #4078f2; }
#sectionCaption { color: #a0a1a7; font-size: 11px; letter-spacing: 1px; }
#recentEmpty { color: #a0a1a7; }
#kpiCard {
  background-color: #ffffff;
  border: 1px solid #d0d0d0;
  border-radius: 8px;
}
QListWidget {
  background-color: #fafafa; color: #a0a1a7;
  border: 1px solid #e0e0e0; border-radius: 8px;
  outline: none;
}
QListWidget::item { padding: 8px 10px; border-radius: 6px; }
QListWidget::item:selected { background-color: rgba(64,120,242,0.15); color: #383a42; }
QListWidget::item:hover:!selected { background-color: #f0f0f0; }

QTabBar::tab { background-color: #f0f0f0; color: #a0a1a7; padding: 7px 14px; border-right: 1px solid #e0e0e0; }
QTabBar::tab:selected { background-color: #fafafa; color: #383a42; border-bottom: 2px solid #4078f2; }

/* Scrollbars */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #d5d5d5; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: #c5c5c5; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: #d5d5d5; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: #c5c5c5; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QSplitter::handle { background-color: #fafafa; }
QSplitter::handle:horizontal { height: 4px; }
QSplitter::handle:vertical { width: 4px; }
QSplitter::handle:hover { background-color: rgba(64,120,242,0.50); }

QStatusBar { background-color: #f0f0f0; color: #a0a1a7; border-top: 1px solid #e0e0e0; }
QToolTip { background-color: #ffffff; color: #383a42; border: 1px solid #d0d0d0; padding: 4px; }

/* Custom titlebar (spec 3.1) */
#titlebar { background-color: #f0eee8; border-bottom: 1px solid #e0ddd5; }
#titlebarTitle { font-size: 12px; font-weight: 500; color: #6a6864; letter-spacing: 0.3px; }
#titlebarClock { font-family: Consolas, monospace; font-size: 11px; color: #a0a1a7; letter-spacing: 0.5px; }
QToolButton#tbBtn { background: transparent; border: none; border-radius: 6px; }
QToolButton#tbBtn:hover { background-color: rgba(0,0,0,0.08); }
QToolButton#tbClose { background: transparent; border: none; border-radius: 6px; }
QToolButton#tbClose:hover { background-color: rgba(255,69,58,0.85); }


/* ---- v1.1: single-column settings + feedback states ---- */
#settingsH1 { font-size: 20px; font-weight: 600; }
#settingsSub { font-size: 12px; color: %TERTIARY%; }
#sectionTitleLabel { font-size: 14px; font-weight: 500; }
#fLabel { font-size: 12px; color: %SECONDARY%; }
#fHint, #fSuffix { font-size: 11px; color: %TERTIARY%; }
#divider { border: none; border-top: 1px solid %BORDER%; }
QPushButton[pill="true"] {
  height: 28px; padding: 0 14px; border-radius: 9999px;
  background: transparent; border: 1px solid %BORDER%;
  color: %SECONDARY%; font-size: 12px;
}
QPushButton[pill="true"]:hover { border-color: %BORDER_HOVER%; color: #383a42; }
QPushButton[pill="true"]:checked { background-color: #4078f2; border-color: #4078f2; color: #ffffff; }
QPushButton[pill="true"]:pressed { background: %PRIMARY_MUTED%; }
#kbdKey {
  background: %ELEVATED%; border: 1px solid %BORDER_HOVER%;
  border-radius: 2px; padding: 1px 6px;
  font-family: 'Consolas'; font-size: 11px; color: #383a42;
}
QMenu { border-radius: 8px; padding: 6px; }
QMenu::item { padding: 7px 24px 7px 16px; border-radius: 6px; margin: 0 4px; }


/* ---- v1.2: problems page pixel-port ---- */
#searchWrap { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; }
#searchWrap:focus-within { border-color: %BORDER_ACTIVE%; }
#searchInput { background: transparent; border: none; font-size: 13px; color: #383a42; }
#searchInput::placeholder { color: #a0a1a7; }
QPushButton[psPrimary="true"] { background: %PRIMARY%; color: #ffffff; border: none; border-radius: 6px; min-height: 32px; padding: 0 14px; font-size: 12px; font-weight: 500; }
QPushButton[psPrimary="true"]:hover { background: %PRIMARY_HOVER%; }
QPushButton[psPrimary="true"]:pressed { background: %PRIMARY%; }
QPushButton[psPrimary="true"]:disabled { color: rgba(255,255,255,0.5); }
QPushButton[psSecondary="true"] { background: %ELEVATED%; color: %SECONDARY%; border: 1px solid %BORDER%; border-radius: 6px; min-height: 32px; padding: 0 14px; font-size: 12px; font-weight: 500; }
QPushButton[psSecondary="true"]:hover { background: %OVERLAY%; border-color: %BORDER_HOVER%; color: #383a42; }
QPushButton[psSecondary="true"]:pressed { background: %BORDER%; }
QPushButton[psSecondary="true"]:disabled { color: #a0a1a7; }
#sectionTitle { font-size: 14px; font-weight: 500; letter-spacing: -0.2px; }
#sectionAction { font-size: 11px; color: %TERTIARY%; }
#favCard { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#favCard:hover { background: %ELEVATED%; border-color: %BORDER_HOVER%; }
#favId { font-family: 'Consolas'; font-size: 11px; font-weight: 500; color: %ACCENT%; }
#favTitle { font-size: 12px; color: %SECONDARY%; }
#problemCard { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#problemCard:hover { background: %ELEVATED%; border-color: %BORDER_HOVER%; }
#problemCard:pressed { background: %OVERLAY%; }
#cardId { font-family: 'Consolas'; font-size: 12px; font-weight: 500; letter-spacing: 0.3px; color: %ACCENT%; }
#cardTitle { font-size: 13px; font-weight: 500; line-height: 1.35; color: #383a42; }
#ojPill { border-radius: 9999px; padding: 2px 7px; font-size: 10px; font-weight: 600; }
#diffLabel { font-size: 10px; color: %TERTIARY%; }
#statsStrip { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#statValue { font-family: 'Consolas'; font-size: 15px; font-weight: 600; letter-spacing: -0.3px; color: #383a42; }
#statStripLabel { font-size: 11px; color: %TERTIARY%; }
#statsDiv { background: %BORDER%; border: none; max-width: 1px; }

/* ---- v1.2: mistakes cards ---- */
QWidget[mistakeCard="true"] { background: %SURFACE%; border: 1px solid %BORDER%; border-left: 3px solid #ff453a; border-radius: 8px; }
QWidget[mistakeCard="true"]:hover { background: %ELEVATED%; }
#redoBtn { background: %PRIMARY_MUTED%; color: %PRIMARY%; border: 1px solid %BORDER_ACTIVE%; border-radius: 6px; padding: 4px 10px; font-size: 11px; }
#redoBtn:hover { background: %PRIMARY_SUBTLE%; }
QPushButton[mchipBtn="true"] { height: 26px; padding: 0 10px; border-radius: 6px; font-family: 'Consolas'; font-size: 11px; font-weight: 600; background: transparent; border: 1px solid transparent; color: %TERTIARY%; }
QPushButton[mchipBtn="true"]:checked { background: %OVERLAY%; color: #383a42; border-color: %BORDER_HOVER%; }

/* ---- v1.2: ai chat ---- */
#aiBubbleUser { background: #2c2520; border: 1px solid rgba(217,119,87,0.12); border-radius: 8px; border-top-right-radius: 6px; padding: 10px 14px; }
#aiBubbleAi { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; border-top-left-radius: 6px; padding: 10px 14px; }
#aiAvatar { border-radius: 14px; font-size: 11px; font-weight: 600; }
#aiComposer { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; color: #383a42; font-size: 13px; }
#aiSend { background: %PRIMARY%; border-radius: 18px; border: none; }
#aiSend:hover { background: %PRIMARY_HOVER%; }

/* ---- v1.2: editor file tabs ---- */
#edTabBar { background: %BASE%; border-bottom: 1px solid %BORDER%; }
#edTab { padding: 0 14px; font-size: 12px; color: %TERTIARY%; border-right: 1px solid %BORDER%; }
#edTabActive { background: %SURFACE%; color: #383a42; border-top: 2px solid %PRIMARY%; }

/* ---- v2: AI coach polish ---- */
#aiBrand { font-size: 14px; font-weight: 500; letter-spacing: 0.3px; color: %PRIMARY%; }
#aiModelChip {
  background: %PRIMARY_MUTED%; color: %PRIMARY%;
  border: 1px solid %BORDER_ACTIVE%; border-radius: 12px;
  padding: 0 10px; min-height: 28px; font-size: 12px; font-weight: 500;
  selection-background-color: %OVERLAY%;
}
#aiModelChip:disabled { color: %TERTIARY%; }
#aiModelChip::drop-down { border: none; width: 16px; }
#aiClearBtn {
  background: transparent; color: %TERTIARY%;
  border: 1px solid %BORDER%; border-radius: 6px;
  padding: 4px 10px; font-size: 11px;
}
#aiClearBtn:hover { color: %SECONDARY%; border-color: %BORDER_HOVER%; }
#aiSend:disabled { background: %BORDER%; }
#aiBubbleAi { background: transparent; border: 1px solid %BORDER%; }
#aiCodeBlock { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 6px; }
#aiCodeHeader { background: %ELEVATED%; border-bottom: 1px solid %BORDER%; }
#aiCodeLang { color: %SECONDARY%; font-family: 'Cascadia Mono', 'Consolas', monospace; font-size: 11px; }
#aiCopyBtn { background: transparent; color: %TERTIARY%; border: none; padding: 4px 10px; font-size: 11px; border-radius: 4px; }
#aiCopyBtn:hover { background: %OVERLAY%; color: %SECONDARY%; }
#aiCodeBody { font-family: 'Cascadia Mono', 'Consolas', monospace; font-size: 12px; padding: 8px 12px; color: %TEXT_PRIMARY%; background: transparent; border: none; }
