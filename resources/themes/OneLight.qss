/* OneLight Theme - Atom One Light */
QMainWindow, QWidget { background-color: %BASE%; color: %TEXT_PRIMARY%; }
QMenuBar { background-color: %SURFACE%; color: %TEXT_PRIMARY%; border-bottom: 1px solid %BORDER%; }
QMenuBar::item:selected { background-color: %ELEVATED%; }
QMenu { background-color: %OVERLAY%; color: %TEXT_PRIMARY%; border: 1px solid %BORDER_HOVER%; border-radius: 8px; padding: 6px; }
QMenu::item { padding: 7px 24px 7px 16px; border-radius: 6px; margin: 0 4px; }
QMenu::item:selected { background-color: %PRIMARY_MUTED%; color: %PRIMARY%; }

/* Inputs */
QLineEdit, QPlainTextEdit, QTextBrowser, QSpinBox, QComboBox {
  background-color: %SURFACE%;
  border: 1px solid %BORDER%;
  border-radius: 6px;
  padding: 4px 8px;
  color: %TEXT_PRIMARY%;
  selection-background-color: %PRIMARY_MUTED%;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus,
QPlainTextEdit:focus, QTextBrowser:focus {
  border: 1px solid %BORDER_ACTIVE%;
}
QLineEdit:disabled, QComboBox:disabled { color: %TERTIARY%; }
QTextBrowser { padding: 8px; }
QTextEdit { background-color: %SURFACE%; color: %TEXT_PRIMARY%; border: none; selection-background-color: %PRIMARY_MUTED%; }

QPushButton {
  background-color: %ELEVATED%; color: %TEXT_PRIMARY%;
  border: 1px solid %BORDER%;
  border-radius: 6px; padding: 5px 14px; font-weight: 500; font-size: 12px;
}
QPushButton:hover { background-color: %OVERLAY%; border-color: %BORDER_HOVER%; color: %PRIMARY%; }
QPushButton:pressed { background-color: %PRIMARY_MUTED%; }
QPushButton:default { border-color: %BORDER_ACTIVE%; }
QPushButton:disabled { color: %TERTIARY%; opacity: 0.5; }

QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
  background-color: %OVERLAY%; color: %TEXT_PRIMARY%;
  border: 1px solid %BORDER_HOVER%; border-radius: 6px;
  selection-background-color: %PRIMARY_MUTED%; outline: none;
}

/* Tables */
QHeaderView::section {
  background-color: %SURFACE%; color: %TERTIARY%;
  border: none; border-right: 1px solid %BORDER%;
  border-bottom: 1px solid %BORDER%;
  padding: 6px 10px; font-weight: 600; font-size: 11px;
}
QTableWidget {
  background-color: %BASE%; alternate-background-color: %SURFACE%;
  gridline-color: %BORDER%;
  border: 1px solid %BORDER%; border-radius: 8px;
}
QTableWidget::item { padding: 6px 8px; border: none; }
QTableWidget::item:hover { background-color: %ELEVATED%; }
QTableWidget::item:selected { background-color: %PRIMARY_MUTED%; color: %TEXT_PRIMARY%; }
QTableView::corner { background-color: %SURFACE%; border: none; }

/* Rail + tab strip */
#activityRail { background-color: %BASE%; border-right: 1px solid %BORDER%; }
#activityRail QToolButton {
  background: transparent; color: %TERTIARY%;
  border: none; border-left: 3px solid transparent;
  border-radius: 6px; padding: 8px 2px;
  font-size: 12px; font-weight: 500;
}
#activityRail QToolButton:hover { background-color: %ELEVATED%; color: %TEXT_PRIMARY%; }
#activityRail QToolButton:checked {
  background-color: %PRIMARY_MUTED%;
  border-left: 3px solid %PRIMARY%; color: %PRIMARY%;
}

#editorTitle { color: %TERTIARY%; padding-left: 12px; background: transparent; }
#recentStrip { color: %TERTIARY%; }
#settingsGroupHeader { font-size: 16px; font-weight: 600; color: %TEXT_PRIMARY%; padding-bottom: 2px; }
#shortcutRef { color: %TERTIARY%; }
#goalBar { border-radius: 4px; min-width: 240px; }

/* Problem cards + KPI cards */
#problemCard {
  background-color: %SURFACE%;
  border: 1px solid %BORDER%;
  border-radius: 8px;
}
#problemCard:hover { background-color: %ELEVATED%; border-color: %BORDER_HOVER%; }
#problemCard:pressed { background-color: %OVERLAY%; }
#cardId { color: %ACCENT%; font-family: Consolas, monospace; font-weight: 600; font-size: 12px; }
#cardTitle { color: %TEXT_PRIMARY%; font-size: 13px; font-weight: 500; }
#chipBadge { background-color: %PRIMARY_SUBTLE%; border-radius: 4px; padding: 2px 6px; }
#recentChip {
  background-color: %SURFACE%; color: %SECONDARY%;
  border: 1px solid %BORDER%;
  border-radius: 6px; padding: 4px 10px;
}
#recentChip:hover { border-color: %BORDER_ACTIVE%; color: %PRIMARY%; }
#sectionCaption { color: %TERTIARY%; font-size: 11px; font-weight: 500; }
#recentEmpty { color: %TERTIARY%; }
#kpiCard {
  background-color: %SURFACE%;
  border: 1px solid %BORDER%;
  border-radius: 8px;
}
#kpiCard:hover { border-color: %BORDER_HOVER%; }
#kpiValue { font-size: 24px; font-weight: 600; color: %TEXT_PRIMARY%; font-family: Consolas, monospace; }
#streakHero { font-size: 28px; font-weight: 700; color: %ACCENT%; font-family: Consolas, monospace; }

QListWidget {
  background-color: %BASE%; color: %SECONDARY%;
  border: 1px solid %BORDER%; border-radius: 8px;
  outline: none;
}
QListWidget::item { padding: 8px 10px; border-radius: 6px; }
QListWidget::item:selected { background-color: %PRIMARY_MUTED%; color: %TEXT_PRIMARY%; }
QListWidget::item:hover:!selected { background-color: %SURFACE%; }

QTabBar::tab { background-color: %BASE%; color: %TERTIARY%; padding: 8px 16px; border-right: 1px solid %BORDER%; font-size: 12px; font-weight: 500; }
QTabBar::tab:selected { background-color: %SURFACE%; color: %TEXT_PRIMARY%; border-bottom: 2px solid %PRIMARY%; }
QTabBar::tab:hover:!selected { background-color: %ELEVATED%; color: %SECONDARY%; }

/* Scrollbars */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: %BORDER_HOVER%; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: %TERTIARY%; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 0; }
QScrollBar::handle:horizontal { background: %BORDER_HOVER%; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: %TERTIARY%; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

/* Splitter */
QSplitter::handle { background-color: %BASE%; }
QSplitter::handle:horizontal { height: 4px; }
QSplitter::handle:vertical { width: 4px; }
QSplitter::handle:hover { background-color: %BORDER_ACTIVE%; }

QStatusBar { background-color: %SURFACE%; color: %TERTIARY%; border-top: 1px solid %BORDER%; font-size: 11px; }
QToolTip { background-color: %OVERLAY%; color: %TEXT_PRIMARY%; border: 1px solid %BORDER_HOVER%; border-radius: 4px; padding: 4px 8px; font-size: 11px; }

/* Custom titlebar */
#titlebar { background-color: %SURFACE%; border-bottom: 1px solid %BORDER%; }
#titlebarTitle { font-size: 12px; font-weight: 600; color: %TEXT_PRIMARY%; letter-spacing: 0.3px; }
#titlebarClock { font-family: Consolas, monospace; font-size: 11px; color: %TERTIARY%; }
QToolButton#tbBtn { background: transparent; border: none; border-radius: 4px; }
QToolButton#tbBtn:hover { background-color: %ELEVATED%; }
QToolButton#tbClose { background: transparent; border: none; border-radius: 4px; }
QToolButton#tbClose:hover { background-color: rgba(255,69,58,0.85); }

/* Settings page */
#settingsH1 { font-size: 20px; font-weight: 600; color: %TEXT_PRIMARY%; }
#settingsSub { font-size: 12px; color: %TERTIARY%; }
#sectionTitleLabel { font-size: 14px; font-weight: 600; color: %TEXT_PRIMARY%; }
#fLabel { font-size: 12px; color: %SECONDARY%; }
#fHint, #fSuffix { font-size: 11px; color: %TERTIARY%; }
#divider { border: none; border-top: 1px solid %BORDER%; }
QPushButton[pill="true"] {
  height: 28px; padding: 0 14px; border-radius: 9999px;
  background: transparent; border: 1px solid %BORDER%;
  color: %SECONDARY%; font-size: 12px;
}
QPushButton[pill="true"]:hover { border-color: %BORDER_HOVER%; color: %TEXT_PRIMARY%; }
QPushButton[pill="true"]:checked { background-color: %PRIMARY%; border-color: %PRIMARY%; color: #ffffff; }
QPushButton[pill="true"]:pressed { background: %PRIMARY_MUTED%; }

#kbdKey {
  background: %ELEVATED%; border: 1px solid %BORDER_HOVER%;
  border-radius: 4px; padding: 2px 6px;
  font-family: 'Consolas'; font-size: 11px; color: %TEXT_PRIMARY%;
}

/* Problems page */
#searchWrap { background: %ELEVATED%; border: 1px solid %BORDER%; border-radius: 8px; }
#searchWrap:focus-within { border-color: %BORDER_ACTIVE%; }
#searchInput { background: transparent; border: none; font-size: 13px; color: %TEXT_PRIMARY%; }
#searchInput::placeholder { color: %TERTIARY%; }
QPushButton[psPrimary="true"] { background: %PRIMARY%; color: #ffffff; border: none; border-radius: 6px; min-height: 32px; padding: 0 14px; font-size: 12px; font-weight: 600; }
QPushButton[psPrimary="true"]:hover { background: %PRIMARY_HOVER%; }
QPushButton[psPrimary="true"]:pressed { background: %PRIMARY%; }
QPushButton[psPrimary="true"]:disabled { opacity: 0.5; }
QPushButton[psSecondary="true"] { background: %ELEVATED%; color: %SECONDARY%; border: 1px solid %BORDER%; border-radius: 6px; min-height: 32px; padding: 0 14px; font-size: 12px; font-weight: 500; }
QPushButton[psSecondary="true"]:hover { background: %OVERLAY%; border-color: %BORDER_HOVER%; color: %TEXT_PRIMARY%; }
QPushButton[psSecondary="true"]:pressed { background: %BORDER%; }
QPushButton[psSecondary="true"]:disabled { color: %TERTIARY%; }
#sectionTitle { font-size: 14px; font-weight: 600; letter-spacing: -0.2px; color: %TEXT_PRIMARY%; }
#sectionAction { font-size: 11px; color: %TERTIARY%; }
#favCard { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#favCard:hover { background: %ELEVATED%; border-color: %BORDER_HOVER%; }
#favId { font-family: 'Consolas'; font-size: 11px; font-weight: 600; color: %ACCENT%; }
#favTitle { font-size: 12px; color: %SECONDARY%; }
#ojPill { border-radius: 4px; padding: 1px 6px; font-size: 11px; font-weight: 500; }
#diffLabel { font-size: 11px; color: %TERTIARY%; }
#statsStrip { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; }
#statValue { font-family: 'Consolas'; font-size: 16px; font-weight: 600; letter-spacing: -0.3px; color: %TEXT_PRIMARY%; }
#statsDiv { background: %BORDER%; border: none; max-width: 1px; }

/* Mistakes page */
QWidget[mistakeCard="true"] { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 6px; }
QWidget[mistakeCard="true"]:hover { background: %ELEVATED%; border-color: %BORDER_HOVER%; }
#redoBtn { background: %PRIMARY_MUTED%; color: %PRIMARY%; border: 1px solid %BORDER_ACTIVE%; border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 500; }
#redoBtn:hover { background: %PRIMARY_SUBTLE%; }
QPushButton[mchipBtn="true"] { height: 28px; padding: 0 12px; border-radius: 6px; font-family: 'Consolas'; font-size: 11px; font-weight: 600; background: transparent; border: 1px solid %BORDER%; color: %TERTIARY%; }
QPushButton[mchipBtn="true"]:checked { background: %OVERLAY%; color: %TEXT_PRIMARY%; border-color: %BORDER_ACTIVE%; }

/* Chips */
QPushButton[chipBtn="true"] {
  height: 28px; padding: 0 12px; border-radius: 14px;
  font-size: 12px; font-weight: 500;
  background: transparent; border: 1px solid %BORDER%;
  color: %SECONDARY%;
}
QPushButton[chipBtn="true"]:hover {
  background: %PRIMARY_SUBTLE%; border-color: %BORDER_ACTIVE%;
  color: %PRIMARY%;
}
QPushButton[chipBtn="true"]:checked {
  background: %PRIMARY_MUTED%; border-color: %PRIMARY%;
  color: %PRIMARY%; font-weight: 600;
}

/* AI Chat */
#aiBrand { font-size: 14px; font-weight: 600; letter-spacing: 0.3px; color: %PRIMARY%; }
#aiModelChip {
  background: %PRIMARY_MUTED%; color: %PRIMARY%;
  border: 1px solid %BORDER_ACTIVE%; border-radius: 12px;
  padding: 0 10px; min-height: 28px; font-size: 12px; font-weight: 500;
  selection-background-color: %OVERLAY%;
}
#aiModelChip:disabled { color: %TERTIARY%; }
#aiModelChip::drop-down { border: none; width: 16px; }
#aiClearBtn {
  background: transparent; color: %TERTIARY%;
  border: 1px solid %BORDER%; border-radius: 6px;
  padding: 4px 10px; font-size: 11px;
}
#aiClearBtn:hover { color: %SECONDARY%; border-color: %BORDER_HOVER%; }
#aiBubbleUser { background: %PRIMARY_MUTED%; border: 1px solid %BORDER_ACTIVE%; border-radius: 8px; border-top-right-radius: 4px; padding: 10px 14px; color: %TEXT_PRIMARY%; }
#aiBubbleAi { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 8px; border-top-left-radius: 4px; padding: 10px 14px; color: %TEXT_PRIMARY%; }
#aiAvatar { border-radius: 14px; font-size: 11px; font-weight: 600; }
#aiComposer { background: transparent; border: none; color: %TEXT_PRIMARY%; font-size: 13px; }
#aiSend { background: %PRIMARY%; border-radius: 18px; border: none; }
#aiSend:hover { background: %PRIMARY_HOVER%; }
#aiSend:disabled { background: %BORDER%; }
#aiCodeBlock { background: %SURFACE%; border: 1px solid %BORDER%; border-radius: 6px; }
#aiCodeHeader { background: %ELEVATED%; border-bottom: 1px solid %BORDER%; }
#aiCodeLang { color: %SECONDARY%; font-family: 'Cascadia Mono', 'Consolas', monospace; font-size: 11px; font-weight: 600; }
#aiCopyBtn { background: transparent; color: %TERTIARY%; border: none; padding: 4px 10px; font-size: 11px; border-radius: 4px; }
#aiCopyBtn:hover { background: %OVERLAY%; color: %TEXT_PRIMARY%; }
#aiCodeBody { font-family: 'Cascadia Mono', 'Consolas', monospace; font-size: 12px; padding: 8px 12px; color: %TEXT_PRIMARY%; background: transparent; border: none; }
